          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 校验失败 -->
        <mxCell id="fail1" value="校验失败&#xa;返回错误信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" value="失败" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="validate" target="fail1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 调用活体检测API -->
        <mxCell id="api1" value="调用活体检测API&#xa;获取认证链接" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">

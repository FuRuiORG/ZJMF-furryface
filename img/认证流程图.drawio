          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 身份证校验 -->
        <mxCell id="validate" value="身份证号码校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="200" height="70" as="geometry" />
        </mxCell>

  <diagram name="认证流程" id="certification-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 用户发起认证请求 -->
        <mxCell id="start" value="用户发起认证请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- 填写姓名和身份证号 -->
        <mxCell id="input" value="填写姓名和身份证号" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="160" height="50" as="geometry" />
